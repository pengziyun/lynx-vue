{
  "name": "@pgg/vue-lynx-rsbuild-plugin",
  "version": "0.1.0",
  "description": "Rspeedy integration for VueLynx native bundles",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -C ../.. exec vitest run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@pgg/vue-lynx-compiler": "workspace:*",
    "@lynx-js/runtime-wrapper-webpack-plugin": "0.1.3",
    "@lynx-js/template-webpack-plugin": "0.10.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
