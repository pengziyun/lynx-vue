{
  "name": "@pgg/vue-lynx-vite-plugin",
  "version": "0.1.0",
  "description": "Vite integration for VueLynx web preview and SSR",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -C ../.. exec vitest run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@pgg/vue-lynx-compiler": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": ">=5.0.0",
    "@vitejs/plugin-vue-jsx": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
