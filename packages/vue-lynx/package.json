{
  "name": "@pgg/vue-lynx",
  "version": "0.1.0",
  "description": "Vue-first Lynx runtime for native, web preview, and SSR workflows",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./internal/thread-background": {
      "types": "./dist/internal/thread-background.d.ts",
      "import": "./dist/internal/thread-background.js",
      "require": "./dist/internal/thread-background.js"
    },
    "./internal/thread-main": {
      "types": "./dist/internal/thread-main.d.ts",
      "import": "./dist/internal/thread-main.js",
      "require": "./dist/internal/thread-main.js"
    },
    "./native-vue": {
      "types": "./dist/native-vue.d.ts",
      "import": "./dist/native-vue.js",
      "require": "./dist/native-vue.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/native-vue.ts src/web.ts src/ssr.ts src/internal/thread-background.ts src/internal/thread-main.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/native-vue.ts src/web.ts src/ssr.ts src/internal/thread-background.ts src/internal/thread-main.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -C ../.. exec vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@vue/reactivity": "^3.5.13",
    "@vue/runtime-core": "^3.5.13",
    "@vue/server-renderer": "^3.5.13",
    "@vue/shared": "^3.5.13",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "keywords": ["vue", "lynx", "renderer", "native", "ssr", "preview"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pgg/new-vue-lynx",
    "directory": "packages/vue-lynx"
  }
}
