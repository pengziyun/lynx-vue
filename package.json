{
  "name": "lynx-vue-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:runtime": "pnpm --filter @lynx-vue/runtime build",
    "build:components": "pnpm --filter @lynx-vue/components build",
    "build:vue-lynx": "pnpm --filter vue-lynx build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint --ext .ts,.vue packages/*/src",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "vue": "^3.4.0"
  }
}
